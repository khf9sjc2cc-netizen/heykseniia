<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>A Small Proposal</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --background: #FFFFFF;
      --text: #202020;
      --muted: #777777;
      --accent: #A34D3D;
      --line: #EAEAEA;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--background);
      color: var(--text);
      font-family: "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .slide {
      min-height: 100svh;
      padding: 32px clamp(24px, 6vw, 80px);
      display: flex;
      flex-direction: column;
    }

    .topbar,
    .bottom-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    .topbar {
      padding-bottom: 18px;
      border-bottom: 1px solid var(--line);
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .content {
      width: 100%;
      max-width: 850px;
      margin: auto;
      padding: 90px 0;
      animation: fade-in 0.8s ease both;
    }

    .eyebrow {
      color: var(--accent);
      font-size: 11px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 28px;
    }

    h1 {
      font-family: "Cormorant Garamond", Georgia, serif;
      font-size: clamp(64px, 11vw, 120px);
      font-weight: 400;
      letter-spacing: -0.045em;
      line-height: 0.82;
    }

    .headline {
      max-width: 760px;
      margin-top: 34px;
      font-family: "Cormorant Garamond", Georgia, serif;
      font-size: clamp(34px, 5.5vw, 64px);
      font-weight: 400;
      line-height: 1.02;
      letter-spacing: -0.025em;
    }

    .description {
      max-width: 360px;
      margin-top: 28px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.8;
    }

    .bottom-bar {
      padding-top: 18px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 11px;
    }

    button {
      border: none;
      background: transparent;
      color: var(--accent);
      font: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      transition: gap 0.2s ease;
    }

    button:hover {
      gap: 18px;
    }

    button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 5px;
    }

    .arrow {
      font-size: 18px;
    }

    /* Second slide placeholder */

    .second-slide {
      display: none;
    }

    .second-slide.active {
      display: flex;
    }

    .first-slide.hidden {
      display: none;
    }

    @keyframes fade-in {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 500px) {
      .slide {
        padding: 24px;
      }

      .content {
        padding: 70px 0;
      }

      .topbar,
      .bottom-bar {
        font-size: 9px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>

  <!-- SLIDE 1 -->

  <main class="slide first-slide" id="slide1">

    <header class="topbar">
      <span>A small proposal</span>
      <span>01 / 04</span>
    </header>

    <section class="content">
      <p class="eyebrow">A note for Kseniia</p>

      <h1>Dear<br>Kseniia,</h1>

      <p class="headline">
        we seem to have skipped the first date.
      </p>

      <p class="description">
        I think there's a simple solution to this problem.
      </p>
    </section>

    <footer class="bottom-bar">
      <span>Entirely reasonable, obviously.</span>

      <button onclick="goToSlide2()">
        Continue <span class="arrow">↗</span>
      </button>
    </footer>

  </main>

  <!-- SLIDE 2: PLACEHOLDER -->

  <main class="slide second-slide" id="slide2">

    <header class="topbar">
      <span>The evidence</span>
      <span>02 / 04</span>
    </header>

    <section class="content">
      <p class="eyebrow">A compelling argument</p>

      <h1>Well,<br>hear me out.</h1>

      <p class="headline">
        I may have a few reasons.
      </p>

      <p class="description">
        The actual reasons will go here. Stay tuned.
      </p>
    </section>

    <footer class="bottom-bar">
      <button onclick="goToSlide1()">
        <span class="arrow">↖</span> Back
      </button>

      <span>More to come.</span>
    </footer>

  </main>

  <script>
    function goToSlide2() {
      document.getElementById("slide1").classList.add("hidden");
      document.getElementById("slide2").classList.add("active");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function goToSlide1() {
      document.getElementById("slide2").classList.remove("active");
      document.getElementById("slide1").classList.remove("hidden");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  </script>

</body>
</html>